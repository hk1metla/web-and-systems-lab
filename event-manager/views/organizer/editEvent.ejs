<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Event</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Axios CDN -->
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>
<body class="bg-gray-100 text-gray-900">
  <%
    // Helper function to safely format date values
    function formatDate(dateValue) {
      var d = new Date(dateValue);
      if (isNaN(d.getTime())) {
        return '';
      }
      return d.toISOString().split('T')[0];
    }
  %>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6 text-center">Edit Event</h1>
    <!-- Edit Event Form -->
    <div class="bg-white p-6 rounded shadow-md">
      <form id="editEventForm" class="space-y-4">
        <div>
          <label for="title" class="block font-medium mb-1">Event Title</label>
          <input type="text" name="title" id="title" value="<%= event.title %>" required
                 class="w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300">
        </div>

        <div>
          <label for="description" class="block font-medium mb-1">Description</label>
          <textarea name="description" id="description" rows="3" required
                    class="w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300"><%= event.description %></textarea>
        </div>

        <div>
          <label for="date" class="block font-medium mb-1">Event Date</label>
          <input type="date" name="date" id="date" value="<%= event.created_at %>" required
                 class="w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="full_price_tickets" class="block font-medium mb-1">Full Price Tickets</label>
            <input type="number" name="full_price_tickets" id="full_price_tickets" value="<%= event.full_price_tickets %>" min="0" required
                   class="w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300">
          </div>
          <div>
            <label for="concession_tickets" class="block font-medium mb-1">Concession Tickets</label>
            <input type="number" name="concession_tickets" id="concession_tickets" value="<%= event.concession_tickets %>" min="0" required
                   class="w-full px-3 py-2 border rounded focus:outline-none focus:ring focus:border-blue-300">
          </div>
        </div>

        <button type="submit"
                class="w-full py-2 bg-green-600 text-white font-semibold rounded hover:bg-green-700 transition-colors">
          Save Changes
        </button>
      </form>
    </div>
    
    <!-- Message Container (Optional) -->
    <div id="messageContainer" class="mt-4"></div>
  </div>

  <!-- Axios form submission script -->
  <script>
    document.getElementById('editEventForm').addEventListener('submit', async function(e) {
      e.preventDefault(); // Prevent the default form submission
      
      // Gather form data
      const title = document.getElementById('title').value;
      const description = document.getElementById('description').value;
      const date = document.getElementById('date').value;
      const fullPriceTickets = document.getElementById('full_price_tickets').value;
      const concessionTickets = document.getElementById('concession_tickets').value;
      
      // Construct the payload object
      const payload = {
        title,
        description,
        date,
        full_price_tickets: parseInt(fullPriceTickets, 10),
        concession_tickets: parseInt(concessionTickets, 10)
      };
      
      try {
        // Send the update request via Axios.
        // Ensure your server has a route matching '/organiser/edit/:id'
        const response = await axios.post('/organiser/edit/<%= event.id %>', payload);
        
        // On success, redirect to the organiser dashboard
        window.location.href = '/organiser';
      } catch (error) {
        console.error('Error updating event:', error);
        document.getElementById('messageContainer').innerHTML =
          '<div class="bg-red-100 text-red-800 p-2 rounded">Error updating event. Please try again.</div>';
      }
    });
  </script>
</body>
</html>
