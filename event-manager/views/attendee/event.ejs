<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= event.title %> - Event Details</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900">
  <div class="container mx-auto px-4 py-8">
    <div class="bg-white p-6 rounded-lg shadow-lg">
      <h1 class="text-3xl font-bold mb-4 text-center"><%= event.title %></h1>
      <p class="text-gray-700 mb-6 leading-relaxed"><%= event.description %></p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h2 class="text-xl font-semibold text-blue-600">Ticket Information</h2>
          <p class="mt-2 text-gray-600">Full Price Tickets: <span class="font-medium"><%= event.full_price_tickets %></span></p>
          <p class="mt-1 text-gray-600">Concession Tickets: <span class="font-medium"><%= event.concession_tickets %></span></p>
        </div>
        <div>
          <h2 class="text-xl font-semibold text-blue-600">Event Details</h2>
          <p class="mt-2 text-gray-600">Created On: 
            <span class="font-medium">
              <% 
                const createdDate = new Date(event.created_at);
                const formattedDate = isNaN(createdDate.getTime()) 
                  ? "N/A" 
                  : createdDate.toLocaleDateString();
              %>
              <%= formattedDate %>
            </span>
          </p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/attendee" class="inline-block bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700 transition-colors">
          Back to Events
        </a>
      </div>
    </div>
  </div>
</body>
</html>
