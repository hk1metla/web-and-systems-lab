<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Attendee Home</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6 text-center">Available Events</h1>
    
    <!-- Available Events List -->
    <div id="availableEventsContainer" class="bg-white p-6 rounded shadow-md mb-8">
      <% if (availableEvents && availableEvents.length > 0) { %>
        <ul id="availableEventsList" class="space-y-2">
          <% availableEvents.forEach(event => { %>
            <li class="flex items-center justify-between border p-4 rounded hover:bg-gray-50" data-id="<%= event.id %>">
              <div>
                <a href="/attendee/event/<%= event.id %>" class="text-xl font-semibold text-blue-600"><%= event.title %></a>
                <p class="mt-1 text-gray-600"><%= event.description %></p>
                <p class="mt-1 text-sm text-gray-500">
                  Date: <%= new Date(event.date).toLocaleDateString() %>
                </p>
              </div>
              <div>
                <!-- Preview booking Button -->
                <button class="bookBtn bg-green-600 text-white px-3 py-2 rounded hover:bg-green-700 transition-colors"
                  data-id="<%= event.id %>">
                  Preview booking
                </button>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <p id="noAvailableEvents" class="text-gray-600">No events available.</p>
      <% } %>
    </div>

    <h1 class="text-3xl font-bold mb-6 text-center">Booked Events</h1>
    <p id="bookingStatus" role="status" aria-live="polite"></p>
  </div>
  <script>
    const status = document.getElementById('bookingStatus');
    document.getElementById('availableEventsContainer').addEventListener('click', async event => {
      const button = event.target.closest('.bookBtn');
      if (!button) return;
      try {
        const response = await fetch('/attendee/book/' + encodeURIComponent(button.dataset.id), { method: 'POST' });
        if (!response.ok) throw new Error('Booking preview unavailable');
        const data = await response.json();
        status.textContent = data.event.title + '. ' + data.message;
      } catch {
        status.textContent = 'The booking preview could not be loaded.';
      }
    });
  </script>
</body>
</html>
